\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Cross-System Summary: Aggregate Precision Across H, H$_2$ and H$_2$O.} (\textbf  {A})~Per-system mean and maximum absolute error across the three reference systems. (\textbf  {B})~Line count per system: $24+17+29=70$ lines across $23$ modalities. (\textbf  {C})~Cumulative line distribution by error bin; more than $90\%$ of lines fall below $0.1\%$ error. (\textbf  {D})~Error landscape over (system, modality, $|$error$|$). The single elevated ridge is the H$_2$ $v=0\to 4$ overtone, where the Morse anharmonicity correction used here is carried at too low an order.}}{23}{figure.caption.21}\protected@file@percent }
\newlabel{fig:summary}{{8}{23}{\textbf {Cross-System Summary: Aggregate Precision Across H, H$_2$ and H$_2$O.} (\textbf {A})~Per-system mean and maximum absolute error across the three reference systems. (\textbf {B})~Line count per system: $24+17+29=70$ lines across $23$ modalities. (\textbf {C})~Cumulative line distribution by error bin; more than $90\%$ of lines fall below $0.1\%$ error. (\textbf {D})~Error landscape over (system, modality, $|$error$|$). The single elevated ridge is the H$_2$ $v=0\to 4$ overtone, where the Morse anharmonicity correction used here is carried at too low an order}{figure.caption.21}{}}
